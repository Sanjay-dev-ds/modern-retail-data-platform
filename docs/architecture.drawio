row=block;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;curved=0;" edge="1" parent="1" source="v_24" target="v_25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;curved=0;" edge="1" parent="1" source="v_25" target="v_26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#017CEE;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;curved=0;exitX=0.45;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v_29" target="v_22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="560"/></Array></mxGeometry></mxCell><mxCell id="e_48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF694B;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;curved=0;exitX=0.42;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v_30" target="v_24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="560"/></Array></mxGeometry></mxCell><mxCell id="v_49" value="&lt;span style='font-size:11px;color:#545B64'&gt;Everything is deployed with &lt;b&gt;Terraform&lt;/b&gt; and runs on one EC2 host (generator + Airflow in Docker). Access is only through AWS Session Manager. See the next pages for the detailed architecture, the dbt model lineage and the star schema.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="84" y="786" width="1760" height="40" as="geometry"/></mxCell><mxCell id="v_50" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;html=1;imageAspect=1;aspect=fixed;fontSize=11;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="788" width="34" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="arch" name="2. Architecture (detailed)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="1680" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v_1" value="&lt;b style='font-size:22px'&gt;Modern Retail Data Platform: architecture &amp;amp; data flow&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#545B64'&gt;Synthetic POS, clickstream and catalog data → AWS sources → S3 → Snowflake (ELT) → dbt star schema, orchestrated hourly by Airflow + Cosmos. Numbered arrows follow the data (legend at the bottom).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="60" as="geometry"/></mxCell><mxCell id="laptop_2" value="Developer laptop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#879196;fontColor=#232F3E;fontSize=13;fontStyle=1;align=left;verticalAlign=top;dashed=1;arcSize=6;spacing=6;container=1;collapsible=0;recursiveResize=0;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="230" height="1260" as="geometry"/></mxCell><mxCell id="tf_3" value="Terraform&lt;br&gt;&lt;span style='font-size:9px'&gt;make tf-plan / tf-apply&lt;/span&gt;" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;html=1;imageAspect=1;aspect=fixed;fontSize=11;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="laptop_2"><mxGeometr