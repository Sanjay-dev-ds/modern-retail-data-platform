" value="&lt;b&gt;retail-gen&lt;/b&gt; (Python + uv)&lt;br&gt;&lt;span style='font-size:9px'&gt;seed: 30 days of history&lt;br&gt;run: every 30 s (systemd-run)&lt;br&gt;sales · voids/returns + refunds&lt;br&gt;deletes · sign-ups · tier/store changes&lt;br&gt;sessions · daily catalog file&lt;br&gt;planted data-quality defects&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3776AB;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;arcSize=6;spacing=6;spacingTop=40;" vertex="1" parent="host_17"><mxGeometry x="20" y="60" width="200" height="170" as="geometry"/></mxCell><mxCell id="py_20" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;html=1;imageAspect=1;aspect=fixed;fontSize=11;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="host_17"><mxGeometry x="30" y="68" width="30" height="30" as="geometry"/></mxCell><mxCell id="uvl_21" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;html=1;imageAspect=1;aspect=fixed;fontSize=11;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="host_17"><mxGeometry x="66" y="68" width="30" height="30" as="geometry"/></mxCell><mxCell id="docker_22" value="Docker Compose · Airflow 3.3.2 (LocalExecutor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FD;strokeColor=#2496ED;fontColor=#1D63AE;fontSize=12;fontStyle=1;align=left;verticalAlign=top;dashed=0;arcSize=6;spacing=6;container=1;collapsible=0;recursiveResize=0;spacingLeft=10;spacingTop=4;" vertex="1" parent="host_17"><mxGeometry x="250" y="60" width="470" height="360" as="geometry"/></mxCell><mxCell id="dockerlogo_23" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;html=1;imageAspect=1;aspect=fixed;fontSize=11;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="docker_22"><mxGeometry x="430" y="6" width="30" height="30" as