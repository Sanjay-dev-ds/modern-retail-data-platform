<mxfile host="app.diagrams.net" agent="retail-data-platform" version="24.0.0"><diagram id="overview" name="1. Overview (simple)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v_1" value="&lt;b style='font-size:24px'&gt;Modern Retail Data Platform: overview&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#545B64'&gt;Synthetic retail data is captured by AWS services, lands in S3, and is modelled in Snowflake with dbt. Airflow runs the pipeline every hour.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="60" as="geometry"/></mxCell><mxCell id="v_2" value="① Generate" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="30" as="geometry"/></mxCell><mxCell id="v_3" value="" style="rounded=0;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="200" height="4" as="geometry"/></mxCell><mxCell id="v_4" value="② Capture (AWS)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="400" height="30" as="geometry"/></mxCell><mxCell id="v_5" value="" style="rounded=0;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="290" y="145" width="400" height="4" as="geometry"/></mxCell><mxCell id="v_6" value="③ Land" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="730" y="110" width="180" height="30" as="geometry"/></mxCell><mxCell id="v_7" value="" style="rounded=0;fillColor=#232F3E;strokeColor=none;" verte