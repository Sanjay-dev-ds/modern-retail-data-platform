xitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="v_28" target="v_29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="493"/><mxPoint x="1300" y="641.8"/></Array></mxGeometry></mxCell><mxCell id="e_56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#879196;strokeWidth=1.2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;curved=0;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="v_32" target="v_29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="943"/><mxPoint x="1300" y="684.2"/></Array></mxGeometry></mxCell><mxCell id="e_57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#879196;strokeWidth=1.2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;curved=0;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.88;entryDx=0;entryDy=0;" edge="1" parent="1" source="v_33" target="v_29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="1033"/><mxPoint x="1300" y="703.28"/></Array></mxGeometry></mxCell><mxCell id="e_58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#879196;strokeWidth=1.2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;curved=0;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="v_29" target="v_34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#879196;strokeWidth=1.2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;curved=0;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v_27" target="v_34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="363"/></Array></mxGeometry></mxCell><mxCell id="e_60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#879196;strokeWidth=1.2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;curved=0;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="v_31" target="v_35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v_61" value="&lt;b&gt;Conventions&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;• CDC: latest _dms_commit_ts wins; deletes kept with is_deleted&lt;br&gt;• Incremental watermark = _loaded_at (arrival), so late data is picked up&lt;br&gt;• SCD2: valid_from ≤ t &amp;lt; valid_to; first version from 1900-01-01&lt;br&gt;• Surrogate keys: sequential integers, assigned once; -1 = Unknown&lt;br&gt;• Tests: structure = error, planted defects = warn&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;arcSize=6;spacing=6;" vertex="1" parent="v_10"><mxGeometry x="20" y="670" width="440" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="star" name="4. Star schema (CORE)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v_1" value="&lt;b style='font-size:22px'&gt;CORE star schema: grain, keys and relationships&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#545B64'&gt;Facts carry the surrogate key of the dimension version valid at the time of the event (point-in-time). Keys are never null: -1 = Unknown member.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="v_2" value="&lt;div style='text-align:left'&gt;&lt;div style='background:#8C4FFF;color:#FFFFFF;padding:4px 8px;font-weight:bold;font-size:13px'&gt;fct_sales_lines&lt;/div&gt;&lt;div style='padding:2px 8px;font-size:10px;color:#232F3E;background:#F4F4F4'&gt;&lt;b&gt;Grain:&lt;/b&gt; one product on a sale (line)&lt;/div&gt;&lt;table style='font-size:10px;width:100%;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;transaction_id, line_no&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;PK (composite)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;txn_date_sk&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;FK → dim_date&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;product_sk&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;FK → dim_product (-1 orphan SKU)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;customer_sk&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;FK → dim_customer (-1 anonymous)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;store_sk&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;FK → dim_store&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;txn_ts · txn_date&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;business time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;channel · status&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;store/online · completed/voided/returned&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;sku · promo_code&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;degenerate attributes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;quantity · unit_price&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;measures&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;gross_amount · discount_amount · net_amount&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;measures (net = revenue)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;is_deleted · _loaded_at&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;soft delete · watermark&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="460" height="241" as="geometry"/></mxCell><mxCell id="v_3" value="&lt;div style='text-align:left'&gt;&lt;div style='background:#545B64;color:#FFFFFF;padding:4px 8px;font-weight:bold;font-size:13px'&gt;dim_date&lt;/div&gt;&lt;div style='padding:2px 8px;font-size:10px;color:#232F3E;background:#F4F4F4'&gt;&lt;b&gt;Grain:&lt;/b&gt; calendar day&lt;/div&gt;&lt;table style='font-size:10px;width:100%;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;date_sk&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;PK · YYYYMMDD&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;date_day&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;date&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;year · quarter · month · month_name&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;week_of_year · day_of_week · day_name&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px'&gt;is_weekend&lt;/td&gt;&lt;td style='padding:1px 6px;color:#545B64'&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;al