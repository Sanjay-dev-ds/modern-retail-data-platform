rget="sf_49"><mxGeometry relative="1" as="geometry" x="0.7"><Array as="points"><mxPoint x="285" y="888"/><mxPoint x="285" y="1400"/><mxPoint x="1900" y="1400"/></Array></mxGeometry></mxCell><mxCell id="e_80" value="dbt build / docs (local)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF694B;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;curved=0;jumpStyle=arc;jumpSize=10;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dbtl_8" target="sf_49"><mxGeometry relative="1" as="geometry" x="0.75"><Array as="points"><mxPoint x="275" y="1058"/><mxPoint x="275" y="1420"/><mxPoint x="2100" y="1420"/></Array></mxGeometry></mxCell><mxCell id="legend_81" value="&lt;b&gt;Data flow&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; retail-gen writes POS changes to RDS: sales, voids/returns with refunds, deletes, sign-ups, tier &amp;amp; store changes · &lt;b&gt;2&lt;/b&gt; DMS reads the PostgreSQL change stream (CDC only: started before the seed) · &lt;b&gt;3&lt;/b&gt; DMS writes Parquet change files to S3 pos/ through the gateway endpoint&lt;br&gt;&lt;b&gt;4–5&lt;/b&gt; clickstream: Kinesis → Firehose → S3 clickstream/events (JSONL.gz) · &lt;b&gt;6&lt;/b&gt; daily supplier catalog snapshot → S3 catalog/products · &lt;b&gt;7&lt;/b&gt; Snowflake stages read S3 through the storage integration&lt;br&gt;&lt;b&gt;8&lt;/b&gt; Airflow load_raw: COPY INTO RAW (idempotent) · &lt;b&gt;9&lt;/b&gt; Cosmos runs dbt: STAGING → CORE → MARTS, tests after each model · &lt;b&gt;10&lt;/b&gt; credentials from Secrets Manager (only DB credentials are secret)&lt;br&gt;&lt;b&gt;11&lt;/b&gt; Terraform deploys everything (state + lock in S3) · &lt;b&gt;12&lt;/b&gt; all access through SSM: no public endpoints · &lt;b&gt;13&lt;/b&gt; the host pulls DAGs, dbt and the generator from GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;arcSize=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="1460" width="1960" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="lineage" name="3. ELT layers &amp; lineage"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1240" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v_1" value="&lt;b style='font-size:22px'&gt;ELT in Snowflake: Airflow DAG, layers and model lineage&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#545B64'&gt;retail_elt runs hourly: load_raw (COPY INTO) → dbt via Cosmos (source freshness, then each model's run and its tests).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="60" as="geometry"/></mxCell><mxCell id="v_2" value="Airflow DAG retail_elt (@hourly · catchup=False · max_active_runs=1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FD;strokeColor=#017CEE;fontColor=#1D63AE;fontSize=13;fontStyle=1;align=left;verticalAlign=top;dashed=0;arcSize=6;spacing=6;container=1;collapsible=0;recursiveResize=0;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1920" height="150" as="geometry"/></mxCell><mxCell id="v_3" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;html=1;imageAspect=1;aspect=fixed;fontSize=11;fontColor=#232F3E;image=data:image/png,;" vertex="1" parent="v_2"><mxGeometry x="1870" y="6" width="34" height="34" as="geometry"/></mxCell><mxCell id="v_4" value="&lt;b&gt;load_raw&lt;/b&gt; (task group)&lt;br&gt;&lt;span style='font-size:10px'&gt;copy_pos_stores · copy_pos_customers · copy_pos_transactions · copy_pos_transaction_lines&lt;br&gt;copy_pos_payments · copy_clickstr